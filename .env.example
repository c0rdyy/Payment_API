APP_ENV=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_API_KEY=dev-secret-change-me

DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0

PAYMENT_GATEWAY_URL=http://mock-provider:9000
PAYMENT_GATEWAY_TIMEOUT_SECONDS=5
PAYMENT_GATEWAY_RETRIES=2

IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_INPROGRESS_TIMEOUT_SECONDS=30

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=payments-api
